#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run lint-staged (ESLint + Prettier on staged JS/TS files).
# Any lint error exits non-zero and blocks the commit locally.
npx lint-staged || exit $?

# Ratchet TypeScript strictness and the no-unused-vars / no-explicit-any
# budgets for the app(s) touched by this commit (#1532, #1533, #1534).
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "^(apps/frontend|apps/backend)/.*\.(ts|tsx|js|jsx)$" || true)
if [ -n "$STAGED_TS" ]; then
  echo "Checking quality budget for staged changes..."
  node scripts/quality-budget.mjs --staged || exit $?
fi

# Check Rust files in contracts/
RUST_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep "^contracts/.*\.rs$" || true)
if [ -n "$RUST_FILES" ]; then
  echo "Checking Rust formatting and linting..."
  cargo fmt --all -- --check || exit $?
  cargo clippy --all-targets --all-features -- -D warnings || exit $?
fi

# Secret scanning with Gitleaks (#1541).
# Scans only the staged diff to keep the hook fast.
# If gitleaks is not installed the check is skipped with a warning so
# developers without the tool can still commit; CI always runs gitleaks
# via the secret-scanning.yml workflow.
if command -v gitleaks >/dev/null 2>&1; then
  echo "Running gitleaks on staged diff..."
  gitleaks protect --staged --config=.gitleaks.toml --redact --verbose || {
    echo ""
    echo "ERROR: gitleaks detected potential secrets in staged files."
    echo "Review the output above, remove the secret, and commit again."
    echo "If this is a false positive, add an allowlist entry to .gitleaks.toml."
    exit 1
  }
else
  echo "WARN: gitleaks not installed — secret scanning skipped locally."
  echo "      Install from https://github.com/gitleaks/gitleaks/releases"
  echo "      or run: brew install gitleaks"
  echo "      CI will still scan via secret-scanning.yml."
fi
