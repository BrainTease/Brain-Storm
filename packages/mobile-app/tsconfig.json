{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@brain-storm/types": ["../types/src"],
      "@brain-storm/types/*": ["../types/src/*"],
      "@brain-storm/sdk": ["../sdk/src"],
      "@brain-storm/sdk/*": ["../sdk/src/*"],
      "@brain-storm/mobile": ["../mobile/src"],
      "@brain-storm/mobile/*": ["../mobile/src/*"]
    }
  }
}
