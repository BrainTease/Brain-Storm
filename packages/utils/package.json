{
  "name": "@brain-storm/utils",
  "version": "1.0.0",
  "private": true,
  "description": "Framework-agnostic shared utilities for Brain-Storm",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit": "npm audit --audit-level=high"
  },
  "keywords": [
    "utils",
    "typescript"
  ],
  "author": "Brain-Storm",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
